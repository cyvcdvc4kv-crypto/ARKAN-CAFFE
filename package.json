{
  "name": "one-million-caffe",
  "version": "1.0.0",
  "description": "One Million Caffe POS",
  "author": "One Million Caffe",
  "main": "electron/main.js",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.onemillioncaffe.app",
    "productName": "One Million Caffe",
    "files": [
      "electron/**/*",
      "www/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "OneMillionCaffe-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}